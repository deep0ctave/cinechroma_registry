---
/**
 * index.astro — Homepage / gallery page.
 *
 * Shows every analyzed movie in a responsive grid. Each card features
 * the color strip (the visual fingerprint) with the title, year, and
 * palette dots below. Movies are sorted newest-first.
 *
 * The hero section sets the tone: this site is about seeing films
 * through their colors, not their plots.
 */
import Layout from "../layouts/Layout.astro";
import MovieCard from "../components/MovieCard.astro";
import movies from "../data/movies.json";

// Sort newest-first so the most recent films appear at the top of the grid.
const sortedMovies = [...movies].sort((a, b) => b.year - a.year);
const totalMovies = sortedMovies.length;

/**
 * Preset color swatches for the color-search panel.
 * Chosen to cover the most common cinematic moods — noir blacks,
 * warm ambers, cool teals, earthy tones, and so on.
 */
const colorPresets = [
  { hex: '#1c1c1c', label: 'Noir' },
  { hex: '#bf2020', label: 'Crimson' },  // brighter, more saturated red — was #8c2a2a (too dark, matched warm shadows)
  { hex: '#c8642a', label: 'Amber' },
  { hex: '#c4a060', label: 'Gold' },
  { hex: '#7a9c5a', label: 'Olive' },
  { hex: '#2a6e40', label: 'Forest' },   // slightly lighter green — was #2a5c3a
  { hex: '#2a8c8a', label: 'Teal' },
  { hex: '#2a5cc8', label: 'Cobalt' },   // more vivid blue — was #2a4a8c (too dark)
  { hex: '#7a6aac', label: 'Violet' },
  { hex: '#c47a85', label: 'Rose' },
  { hex: '#8aafc4', label: 'Ice' },
  { hex: '#c4743a', label: 'Terra' },
];
---

<Layout>
  <!-- Hero section -->
  <section class="mb-16 md:mb-24" data-movie-search>
    <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl tracking-tight text-text mb-4">
      cinechroma
    </h1>
    <p class="text-text-secondary text-base md:text-lg max-w-xl leading-relaxed">
      Every film has a color story. We extract it frame by frame — dominant
      hues, luminance bands, full palettes — and lay it bare as a visual
      fingerprint.
    </p>
    <p class="text-text-tertiary text-sm mt-3">
      {totalMovies} films analyzed
    </p>

    <!-- Search stays on the homepage so filtering feels instant and local. -->
    <form class="mt-8 max-w-2xl" role="search" aria-label="Search the movie collection">
      <label for="movie-search-input" class="sr-only">Search films by title or year</label>
      <div class="search-shell">
        <svg
          class="search-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.6-5.15a7.5 7.5 0 11-15 0 7.5 7.5 0 0115 0z" />
        </svg>

        <input
          id="movie-search-input"
          type="search"
          name="q"
          class="search-input"
          placeholder="Search by title or year"
          autocomplete="off"
          spellcheck="false"
          data-search-input
        />

        <button
          type="button"
          class="search-clear"
          data-search-clear
          hidden
        >
          Clear
        </button>
      </div>

      <p class="mt-3 text-sm text-text-tertiary" data-search-summary>
        {totalMovies} films shown
      </p>
    </form>
  </section>

  <!-- Color search — find films by overall palette similarity -->
  <section class="mb-12 md:mb-16" data-color-panel>
    <div class="flex items-center justify-between mb-4">
      <p class="text-xs uppercase tracking-widest text-text-tertiary">Find by color</p>
      <button
        type="button"
        class="text-xs text-text-secondary hover:text-text transition-colors"
        data-color-clear
        hidden
      >
        Clear
      </button>
    </div>

    <!-- Preset swatches cover common cinematic moods; the + swatch opens a full color picker -->
    <div class="flex flex-wrap gap-2 items-center" data-swatch-row>
      {colorPresets.map(({ hex, label }) => (
        <button
          type="button"
          class="color-swatch"
          style={`background-color: ${hex}`}
          title={label}
          data-preset-color={hex}
          aria-label={`Find films with ${label} tones`}
        />
      ))}

      <!-- Custom color picker — styled as a "+" swatch -->
      <label
        class="color-swatch color-picker-swatch"
        title="Pick a custom color"
        aria-label="Pick a custom color"
      >
        <input type="color" class="sr-only" data-color-picker value="#8a6abf" />
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </label>
    </div>

    <!-- Chips showing which colors are active — click × to remove one -->
    <div class="flex flex-wrap gap-2 mt-4" data-selected-colors hidden></div>

    <!-- Tells the user the grid is now sorted by match -->
    <p class="text-sm text-text-tertiary mt-3" data-color-summary hidden></p>
  </section>

  <!-- Movie grid -->
  <section>
    <div class="flex items-center justify-between gap-4 mb-8">
      <h2 class="text-xs uppercase tracking-widest text-text-tertiary">
        Collection
      </h2>
    </div>

    <div
      class="search-empty-state"
      data-search-empty
      hidden
    >
      <p class="font-medium text-text">No films match that search.</p>
      <p class="text-sm text-text-secondary mt-2">
        Try a different title or year for
        <span data-search-empty-query></span>.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6" data-search-grid>
      {sortedMovies.map((movie) => (
        <div
          data-search-item
          data-search-text={`${movie.title} ${movie.year} ${movie.slug}`.toLowerCase()}
          data-palette={JSON.stringify([...(movie.palettes.light ?? []), ...(movie.palettes.medium ?? []), ...(movie.palettes.dark ?? [])])}
        >
          <MovieCard movie={movie} />
        </div>
      ))}
    </div>
  </section>
</Layout>

<script is:inline>
  const searchRoot = document.querySelector('[data-movie-search]');

  if (searchRoot) {
    const searchInput = searchRoot.querySelector('[data-search-input]');
    const clearButton = searchRoot.querySelector('[data-search-clear]');
    const summary = searchRoot.querySelector('[data-search-summary]');
    const items = Array.from(document.querySelectorAll('[data-search-item]'));
    const emptyState = document.querySelector('[data-search-empty]');
    const emptyQuery = document.querySelector('[data-search-empty-query]');
    const totalItems = items.length;

    const normalizeQuery = (value) => value.trim().toLowerCase().replace(/\s+/g, ' ');

    const syncUrl = (value) => {
      const url = new URL(window.location.href);

      if (value) {
        url.searchParams.set('q', value);
      } else {
        url.searchParams.delete('q');
      }

      history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    };

    const updateResults = (rawValue) => {
      const trimmedValue = rawValue.trim();
      const query = normalizeQuery(rawValue);
      let visibleItems = 0;

      for (const item of items) {
        const haystack = item.dataset.searchText || '';
        const matches = !query || haystack.includes(query);

        item.hidden = !matches;

        if (matches) {
          visibleItems += 1;
        }
      }

      summary.textContent = query
        ? `${visibleItems} of ${totalItems} films match "${trimmedValue}"`
        : `${totalItems} films shown`;

      clearButton.hidden = trimmedValue.length === 0;
      emptyState.hidden = visibleItems !== 0;
      emptyQuery.textContent = trimmedValue ? `“${trimmedValue}”` : 'that query';

      syncUrl(trimmedValue);
    };

    searchRoot.querySelector('form')?.addEventListener('submit', (event) => {
      event.preventDefault();
    });

    searchInput.addEventListener('input', (event) => {
      updateResults(event.currentTarget.value);
    });

    clearButton.addEventListener('click', () => {
      searchInput.value = '';
      updateResults('');
      searchInput.focus();
    });

    const initialQuery = new URLSearchParams(window.location.search).get('q') || '';

    if (initialQuery) {
      searchInput.value = initialQuery;
    }

    updateResults(initialQuery);
  }

  // ── Color search ───────────────────────────────────────────────────────────
  // Sorts the grid by palette similarity to whatever colors the user picks.
  // Text filtering and color sorting are independent — they do not conflict.
  (function () {
    const grid             = document.querySelector('[data-search-grid]');
    const colorClearBtn    = document.querySelector('[data-color-clear]');
    const selectedColorsEl = document.querySelector('[data-selected-colors]');
    const colorSummaryEl   = document.querySelector('[data-color-summary]');
    const swatchButtons    = Array.from(document.querySelectorAll('[data-preset-color]'));
    const colorPickerInput = document.querySelector('[data-color-picker]');
    const allItems         = Array.from(document.querySelectorAll('[data-search-item]'));

    if (!grid) return;

    // Record original DOM order so we can restore it when colors are cleared.
    allItems.forEach((item, i) => { item.dataset.originalIndex = i; });

    let selectedColors = [];  // array of lowercase hex strings

    // Convert a hex colour to CIE L*a*b* — the perceptually uniform
    // colour space used by professionals for "how different do these
    // actually look to a human?" calculations.
    //
    // Pipeline: hex → sRGB [0–1] → linear RGB → CIE XYZ (D65) → Lab
    function hexToLab(hex) {
      // 1. Parse hex to linear-light sRGB values
      const n = parseInt(hex.replace('#', ''), 16);
      let r = ((n >> 16) & 255) / 255;
      let g = ((n >> 8)  & 255) / 255;
      let b = ( n        & 255) / 255;

      // 2. Gamma-expand sRGB → linear (IEC 61966-2-1)
      const lin = v => v > 0.04045 ? Math.pow((v + 0.055) / 1.055, 2.4) : v / 12.92;
      r = lin(r); g = lin(g); b = lin(b);

      // 3. Linear RGB → XYZ (D65 illuminant, sRGB primaries)
      const x = (r * 0.4124564 + g * 0.3575761 + b * 0.1804375) / 0.95047;
      const y = (r * 0.2126729 + g * 0.7151522 + b * 0.0721750) / 1.00000;
      const z = (r * 0.0193339 + g * 0.1191920 + b * 0.9503041) / 1.08883;

      // 4. XYZ → Lab (CIE standard cube-root compression)
      const f = v => v > 0.008856 ? Math.cbrt(v) : 7.787 * v + 16 / 116;
      return [
        116 * f(y) - 16,         // L* lightness  0–100
        500 * (f(x) - f(y)),     // a* green–red axis
        200 * (f(y) - f(z)),     // b* blue–yellow axis
      ];
    }

    // CIE94 colour distance (simplified, kL=2).
    //
    // CIE76 (plain Euclidean Lab) weighs lightness equally with hue, so a
    // "dark brownish-red" can beat a "vivid bright red" just because its
    // darkness is numerically close. CIE94 fixes that by halving the weight
    // of lightness (kL=2), making hue and chroma similarity dominate.
    //
    // In practice: picking Crimson now ranks genuinely red films first,
    // regardless of whether their reds are dark or bright.
    function colorDistance(a, b) {
      const [l1, a1, b1] = hexToLab(a);
      const [l2, a2, b2] = hexToLab(b);
      const C1 = Math.sqrt(a1*a1 + b1*b1);  // chroma of colour a
      const C2 = Math.sqrt(a2*a2 + b2*b2);  // chroma of colour b
      const dL = l1 - l2;
      const dC = C1 - C2;
      // ΔH: Euclidean distance in a*b* plane minus the chroma component
      const dH = Math.sqrt(Math.max(0, (a1-a2)**2 + (b1-b2)**2 - dC*dC));
      // kL=2 means lightness is half as important as hue/chroma
      return Math.sqrt((dL/2)**2 + dC**2 + dH**2);
    }

    // Score a movie card against the active colour set.
    //
    // We use the light + medium + dark palettes (30 colours) but do NOT
    // compare against each swatch individually — that rewards films that
    // merely have one close swatch buried in an otherwise unrelated palette.
    //
    // Instead we compute the Lab CENTROID of all 30 palette colours.
    // The centroid is the film's single "average colour" — it directly
    // captures the dominant colour tendency of the whole film.
    //
    //   Midnight in Paris (warm amber throughout) → centroid ≈ warm orange
    //   The Cook, the Thief (deep reds throughout) → centroid ≈ dark red
    //   Eternal Sunshine (cool blues/grays)        → centroid ≈ cold gray-blue
    //
    // Selecting red then ranks The Cook first and Midnight in Paris
    // well behind it, because amber ≠ red at the centroid level.
    //
    // Lower score = closer / better match.
    function scoreMovie(item) {
      const palette = JSON.parse(item.dataset.palette || '[]');
      if (!palette.length || !selectedColors.length) return 0;

      // Compute the Lab centroid of this film's palette.
      let sumL = 0, sumA = 0, sumB = 0;
      for (const c of palette) {
        const [l, a, b] = hexToLab(c);
        sumL += l; sumA += a; sumB += b;
      }
      const n = palette.length;
      const centroid = [sumL / n, sumA / n, sumB / n];

      // Measure how far the centroid is from each selected colour.
      let total = 0;
      for (const selected of selectedColors) {
        const [l, a, b] = hexToLab(selected);
        const C1 = Math.sqrt(a*a + b*b);
        const C2 = Math.sqrt(centroid[1]**2 + centroid[2]**2);
        const dL = l - centroid[0];
        const dC = C1 - C2;
        const dH = Math.sqrt(Math.max(0, (a-centroid[1])**2 + (b-centroid[2])**2 - dC*dC));
        total += Math.sqrt((dL/2)**2 + dC**2 + dH**2);
      }
      return total / selectedColors.length;
    }

    // Re-sort the grid by colour score, or restore the original DOM order.
    function applySortByColor() {
      if (!selectedColors.length) {
        const restored = [...allItems].sort(
          (a, b) => Number(a.dataset.originalIndex) - Number(b.dataset.originalIndex)
        );
        for (const item of restored) grid.appendChild(item);
        colorClearBtn.hidden    = true;
        selectedColorsEl.hidden = true;
        colorSummaryEl.hidden   = true;
        return;
      }

      const scored = allItems.map(item => ({ item, score: scoreMovie(item) }));
      scored.sort((a, b) => a.score - b.score);
      for (const { item } of scored) grid.appendChild(item);

      colorClearBtn.hidden  = false;
      colorSummaryEl.hidden = false;
      colorSummaryEl.textContent = selectedColors.length === 1
        ? 'Sorted by closest palette match'
        : 'Sorted by closest match to ' + selectedColors.length + ' colors';
    }

    // Rebuild the chip row that shows which colours are currently active.
    function renderChips() {
      selectedColorsEl.innerHTML = '';
      if (!selectedColors.length) { selectedColorsEl.hidden = true; return; }
      selectedColorsEl.hidden = false;

      for (const hex of selectedColors) {
        const chip = document.createElement('div');
        chip.className = 'color-chip';

        const dot = document.createElement('span');
        dot.className        = 'color-chip-dot';
        dot.style.background = hex;

        const label = document.createElement('span');
        label.className   = 'color-chip-hex';
        label.textContent = hex;

        const remove = document.createElement('button');
        remove.type      = 'button';
        remove.className = 'color-chip-remove';
        remove.setAttribute('aria-label', 'Remove colour ' + hex);
        remove.textContent = '\u00d7';
        remove.addEventListener('click', () => {
          selectedColors = selectedColors.filter(c => c !== hex);
          refreshSwatchStates();
          renderChips();
          applySortByColor();
        });

        chip.appendChild(dot);
        chip.appendChild(label);
        chip.appendChild(remove);
        selectedColorsEl.appendChild(chip);
      }
    }

    // Sync the selected-ring on preset swatch buttons.
    function refreshSwatchStates() {
      for (const btn of swatchButtons) {
        const isOn = selectedColors.includes(btn.dataset.presetColor.toLowerCase());
        btn.setAttribute('data-selected', isOn ? 'true' : 'false');
      }
    }

    // Toggle a colour on/off (max 4 active at once to avoid clutter).
    function toggleColor(rawHex) {
      const hex = rawHex.toLowerCase();
      if (selectedColors.includes(hex)) {
        selectedColors = selectedColors.filter(c => c !== hex);
      } else {
        if (selectedColors.length >= 4) selectedColors.shift();
        selectedColors.push(hex);
      }
      refreshSwatchStates();
      renderChips();
      applySortByColor();
    }

    for (const btn of swatchButtons) {
      btn.addEventListener('click', () => toggleColor(btn.dataset.presetColor));
    }

    // Custom colour picker — fires while dragging so sorting feels live.
    // Replaces the previous custom pick rather than stacking new entries.
    if (colorPickerInput) {
      colorPickerInput.addEventListener('input', (e) => {
        const customIdx = selectedColors.findIndex(
          c => !swatchButtons.some(b => b.dataset.presetColor.toLowerCase() === c)
        );
        if (customIdx !== -1) selectedColors.splice(customIdx, 1);
        selectedColors.push(e.target.value.toLowerCase());
        refreshSwatchStates();
        renderChips();
        applySortByColor();
      });
    }

    colorClearBtn?.addEventListener('click', () => {
      selectedColors = [];
      if (colorPickerInput) colorPickerInput.value = '#8a6abf';
      refreshSwatchStates();
      renderChips();
      applySortByColor();
    });
  })();
</script>
