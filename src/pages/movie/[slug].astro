---
/**
 * [slug].astro — Dynamic movie detail page.
 *
 * Shows: full color strip, 16-color palette with weight bars,
 * and a "Similar Films" section based on OKLAB histogram cosine similarity.
 */
import Layout from "../../layouts/Layout.astro";
import MovieCard from "../../components/MovieCard.astro";
import movies from "../../data/movies.json";

export function getStaticPaths() {
  return movies.map((movie) => ({
    params: { slug: movie.slug },
    props: { movie },
  }));
}

const { movie } = Astro.props;

// Build a slug → movie map for resolving similar films
const movieBySlug = Object.fromEntries(movies.map((m) => [m.slug, m]));
const similarMovies = (movie.similar || [])
  .map((s) => movieBySlug[s])
  .filter(Boolean);
---

<Layout
  title={`${movie.title} (${movie.year}) — cinechroma`}
  description={`Color analysis of ${movie.title} (${movie.year}). ${movie.frameCount} frames analyzed.`}
  ogUrl={`https://cinechroma.avinashaldhapati.com/movie/${movie.slug}/`}
>
  <!-- Back link -->
  <a
    href="/"
    class="inline-flex items-center gap-1 text-sm text-text-tertiary hover:text-text transition-colors mb-8 group"
  >
    <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
    all films
  </a>

  <!-- Title section -->
  <section class="mb-10 md:mb-14">
    <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl tracking-tight text-text mb-2">
      {movie.title}
    </h1>
    <div class="flex items-center gap-4 text-sm text-text-tertiary">
      <span>{movie.year}</span>
      <span class="w-1 h-1 rounded-full bg-text-tertiary"></span>
      <span>{movie.frameCount.toLocaleString()} frames analyzed</span>
    </div>
  </section>

  <!-- Color strip — full width, the visual fingerprint -->
  <section class="mb-14 md:mb-20">
    <h2 class="text-xs uppercase tracking-widest text-text-tertiary mb-4">
      Color Timeline
    </h2>
    <div class="w-full h-20 sm:h-28 md:h-36 rounded-lg overflow-hidden border border-border">
      <img
        src={`/movies/${movie.slug}/strip.png`}
        alt={`Color timeline for ${movie.title}`}
        class="strip-image"
      />
    </div>
    <p class="text-xs text-text-tertiary mt-3">
      Each vertical line represents one frame's dominant color, left to right from opening to credits.
    </p>
  </section>

  <!-- 16-color palette with weight bars -->
  <section class="mb-14 md:mb-20">
    <h2 class="text-xs uppercase tracking-widest text-text-tertiary mb-8">
      Colour Palette
    </h2>
    <div class="grid grid-cols-8 sm:grid-cols-8 md:grid-cols-16 gap-2">
      {(movie.colors || []).map((c) => {
        const weightPct = Math.round(c.weight * 100);
        const barH = Math.max(2, Math.round(c.weight * 400)); // max ~40px bar
        return (
          <div class="flex flex-col items-center gap-1 group min-w-0">
            <!-- Weight bar -->
            <div class="w-full flex items-end justify-center" style="height: 40px;">
              <div
                class="w-5 rounded-t-sm opacity-80"
                style={`background-color: ${c.hex}; height: ${barH}px;`}
                title={`${weightPct}%`}
              />
            </div>
            <!-- Swatch -->
            <div
              class="w-full aspect-square rounded border border-white/10"
              style={`background-color: ${c.hex};`}
            />
            <!-- Hex label — always visible -->
            <p class="text-[9px] font-mono text-text-tertiary text-center leading-tight">
              {c.hex}
            </p>
            <p class="text-[9px] text-text-tertiary text-center">{weightPct}%</p>
          </div>
        );
      })}
    </div>
    <p class="text-xs text-text-tertiary mt-4">
      16 dominant colors extracted via MiniBatchKMeans in OKLAB space. Bar height proportional to color frequency.
      Near-black, near-white, and near-grey pixels excluded before clustering.
    </p>
  </section>

  <!-- Similar films -->
  {similarMovies.length > 0 && (
    <section class="mb-14 md:mb-20">
      <h2 class="text-xs uppercase tracking-widest text-text-tertiary mb-6">
        Similar Films
      </h2>
      <p class="text-xs text-text-tertiary mb-6">
        Based on cosine similarity of OKLAB color histograms across {movie.frameCount.toLocaleString()} analyzed frames.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {similarMovies.map((sim) => (
          <MovieCard movie={sim} />
        ))}
      </div>
    </section>
  )}
</Layout>
